#!/usr/bin/env bash
# FleetPanel operator CLI. Run without arguments for the interactive menu.
set -euo pipefail

FLEET_DIR=/opt/fleetpanel
APP_DIR="$FLEET_DIR/app"
DATA_DIR="$FLEET_DIR/data"
BACKUPS_DIR="$FLEET_DIR/backups"
KEY_FILE="$FLEET_DIR/config/master.key"
SERVICE_USER=fleetpanel
SERVICE=fleetpanel.service
HEALTH_URL=http://127.0.0.1:3000/api/health
HELPER=/usr/local/sbin/fleetpanel-helper
REF_FILE=/etc/fleetpanel/ref
PANEL_SITE=/etc/nginx/sites-available/fleetpanel-panel.conf
PANEL_LINK=/etc/nginx/sites-enabled/fleetpanel-panel.conf
REF_RE='^[A-Za-z0-9._/-]{1,100}$'
PURGE_PHRASE='PERMANENTLY DELETE INSTANCES'

if [[ -t 1 ]]; then
  C_OK=$'\033[0;32m' C_WARN=$'\033[1;33m' C_BAD=$'\033[0;31m' C_DIM=$'\033[2m' C_B=$'\033[1m' C_0=$'\033[0m'
else
  C_OK='' C_WARN='' C_BAD='' C_DIM='' C_B='' C_0=''
fi

usage() {
  cat <<'EOF'
Usage: fleetpanel [command]        (no command: interactive menu)

Service
  status                     Service state, health, version and instances
  doctor                     Check the whole host and report PASS / WARN / FAIL
  start | stop | restart     Control the panel service (bots keep running)
  logs [N] [-f]              Last N log lines (default 100); -f follows
  logs SLUG [N] [-f]         Log of a bot (Python bots: the bot; PHP bots: their cron jobs)

Instances and backups
  instances                  List bot instances
  backups [SLUG]             List instance backups and control-plane backups
  backup                     Back up the control plane (database + master key)
  backup SLUG                Back up one instance (files + database)
  restore FILE.fleet         Restore an encrypted backup (e.g. from Telegram; asks for the passphrase)
  restore FILE.tar.gz        Restore a control-plane backup
  restore BACKUP_ID          Restore an instance backup (safety backup first)

Administrators
  admins                     List administrators
  create-admin USER [--role ROLE]
  reset-password USER        Set a new password and revoke USER's sessions

Versions
  version                    Installed version, commit and update channel
  channel [REF]              Show or set the update channel: main (stable), dev (test builds) or a tag
  update                     Build the channel's latest version and switch with rollback

Server
  firewall [status]          Show the firewall (ufw) rules and ping state
  firewall enable [--block-ping|--allow-ping] [--yes]
                             Deny incoming traffic except SSH, HTTP, HTTPS and the panel port
  firewall disable [--yes]   Turn the firewall off

  uninstall                  Remove FleetPanel (bots keep running; purge mode optional)
EOF
}

die() { printf '%s\n' "${C_BAD}error:${C_0} $*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "this command needs root: sudo fleetpanel $*"; }
app_cli() { sudo -u "$SERVICE_USER" env "FLEET_DIR=$FLEET_DIR" node "$APP_DIR/dist/cli.js" "$@"; }

healthy() {
  local _
  for _ in $(seq 1 20); do
    curl -fsS "$HEALTH_URL" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

# Prompt from the terminal (works even when stdin is a pipe).
ask() {
  local reply=""
  read -r -p "$1" reply </dev/tty || true
  printf '%s' "$reply"
}

current_ref() {
  local ref
  ref="$(cat "$REF_FILE" 2>/dev/null || echo main)"
  [[ $ref =~ $REF_RE ]] || die "invalid ref in $REF_FILE"
  printf '%s' "$ref"
}

app_version() { node -p "require('$APP_DIR/package.json').version" 2>/dev/null || echo unknown; }

# ---------------------------------------------------------------------------
# Build and update

# Explicit && chain: build is called as `if ! build …`, where bash ignores `set -e`,
# so a failed step would otherwise be skipped silently. Output goes to the caller's log.
build() {
  (
    cd "$1" \
      && npm ci --ignore-scripts --no-audit --no-fund --loglevel=error --prefer-offline \
      && npm rebuild argon2 better-sqlite3 esbuild --loglevel=error \
      && npm run build --silent \
      && npm prune --omit=dev --no-audit --no-fund --loglevel=error
  ) || return 1
  [[ -f $1/dist/server.js && -f $1/dist/cli.js ]] || { echo "build produced no dist/server.js" >&2; return 1; }
}

# version_lt A B: true when version A is older than B.
# sort -V puts "~" before anything, so 0.4.0~beta.1 sorts before 0.4.0: a pre-release is older.
version_lt() {
  local a="${1/-/\~}" b="${2/-/\~}"
  [[ $a != "$b" && "$(printf '%s\n%s\n' "$a" "$b" | sort -V | head -n 1)" == "$a" ]]
}

# Panels installed before v0.4.1 accept 1 MB request bodies everywhere. Add the large-upload
# location for bot database imports once, keeping the old file if nginx rejects the result.
ensure_panel_uploads() {
  [[ -f $PANEL_SITE ]] || return 0
  grep -q 'import-db' "$PANEL_SITE" && return 0
  local tmp
  tmp="$(mktemp)"
  awk '
    !done && /^[[:space:]]*location \/ \{/ {
      print "    # Bot database imports (Instances -> Import database): large uploads on this path only."
      print "    location ~ ^/api/instances/[0-9]+/import-db$ {"
      print "        client_max_body_size 512m;"
      print "        proxy_request_buffering off;"
      print "        proxy_pass http://127.0.0.1:3000;"
      print "        proxy_http_version 1.1;"
      print "        proxy_set_header Host $http_host;"
      print "        proxy_set_header X-Real-IP $remote_addr;"
      print "        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;"
      print "        proxy_set_header X-Forwarded-Proto $scheme;"
      print "        proxy_read_timeout 1800s;"
      print "    }"
      print ""
      done = 1
    }
    { print }' "$PANEL_SITE" > "$tmp"
  cp -p "$PANEL_SITE" "$tmp.orig"
  cat "$tmp" > "$PANEL_SITE"
  if nginx -t >/dev/null 2>&1; then
    systemctl reload nginx || true
  else
    cat "$tmp.orig" > "$PANEL_SITE"
    echo "${C_WARN}Could not enable large database uploads in $PANEL_SITE (nginx -t failed); left unchanged.${C_0}" >&2
  fi
  rm -f "$tmp" "$tmp.orig"
}

install_system_files() {
  local dir="$1"
  install -o root -g root -m 0755 "$dir/deploy/fleetpanel-helper" "$HELPER"
  # This script is still running: replace it by rename so bash keeps reading the old inode.
  install -o root -g root -m 0755 "$dir/bin/fleetpanel" /usr/local/bin/fleetpanel.new
  mv -f /usr/local/bin/fleetpanel.new /usr/local/bin/fleetpanel
}

# Copies the SQLite database together with its WAL, so committed-but-not-checkpointed
# writes survive (the service may have crashed instead of shutting down cleanly).
copy_db() {
  local from="$1" to="$2" ext
  for ext in "" -wal -shm; do
    rm -f "$to$ext"
    if [[ -f "$from$ext" ]]; then install -o "$SERVICE_USER" -g "$SERVICE_USER" -m 0600 "$from$ext" "$to$ext"; fi
  done
}

# Instances with an install or delete in progress (the panel runs those itself).
busy_instances() {
  app_cli list-instances --tsv 2>/dev/null | awk -F'\t' '$4 == "provisioning" || $4 == "deleting" {print $1}' | tr '\n' ' ' || true
}

# Builds the new version in a staging directory while the panel keeps running, then
# swaps directories. Downtime is a few seconds, and rollback is a rename (no rebuild).
cmd_update() {
  local prev ref url snapshot busy log
  local staging="$FLEET_DIR/app.new" previous="$FLEET_DIR/app.prev"
  # Updating restarts the panel, which would cut an install short ("Interrupted by a control-plane restart").
  busy="$(busy_instances)"
  if [[ -n $busy ]]; then
    echo "${C_WARN}Being installed or deleted right now: ${busy% }.${C_0} Updating restarts the panel and interrupts that."
    [[ "$(ask 'Wait for it to finish first. Update anyway? [y/N] ')" =~ ^[Yy]$ ]] || die "update cancelled; nothing was changed."
  fi
  ref="$(current_ref)"
  url="$(git -C "$APP_DIR" remote get-url origin)"
  prev="$(git -C "$APP_DIR" rev-parse HEAD)"

  echo "Checking $ref…"
  rm -rf "$staging"
  git clone --quiet --depth 1 --branch "$ref" "$url" "$staging"
  if [[ "$(git -C "$staging" rev-parse HEAD)" == "$prev" ]]; then
    rm -rf "$staging"
    echo "Already up to date (v$(app_version))."
    return 0
  fi
  local have want
  have="$(app_version)"
  want="$(node -p "require('$staging/package.json').version" 2>/dev/null || echo 0)"
  if version_lt "$want" "$have"; then
    echo "${C_WARN}'$ref' has v$want, older than the installed v$have.${C_0}"
    if [[ "$(ask 'Install the older version? [y/N] ')" != [Yy] ]]; then
      rm -rf "$staging"
      die "update cancelled; nothing was changed."
    fi
  fi
  echo "Building v$want (the panel keeps running)…"
  log="$(mktemp /tmp/fleetpanel-update.XXXXXX)"
  if ! build "$staging" >"$log" 2>&1; then
    tail -n 25 "$log" >&2
    rm -rf "$staging"
    die "build failed; nothing was changed (full log: $log)"
  fi
  rm -f "$log"
  chown -R root:root "$staging"

  snapshot="$BACKUPS_DIR/control-plane-$(date -u +%Y%m%dT%H%M%SZ).db"
  echo "Switching…"
  systemctl stop "$SERVICE"
  copy_db "$DATA_DIR/fleetpanel.db" "$snapshot"
  rm -rf "$previous"
  mv "$APP_DIR" "$previous"
  mv "$staging" "$APP_DIR"
  install_system_files "$APP_DIR"
  ensure_panel_uploads
  systemctl start "$SERVICE"

  if ! healthy; then
    echo "Health check failed: rolling back to ${prev:0:12}" >&2
    journalctl -u "$SERVICE" -n 15 --no-pager >&2 || true
    systemctl stop "$SERVICE" || true
    rm -rf "$APP_DIR.failed"
    mv "$APP_DIR" "$APP_DIR.failed"
    mv "$previous" "$APP_DIR"
    install_system_files "$APP_DIR"
    copy_db "$snapshot" "$DATA_DIR/fleetpanel.db"
    systemctl start "$SERVICE"
    die "rolled back. The failed build is kept in $APP_DIR.failed for inspection."
  fi
  rm -rf "$previous"
  # Keep the three newest pre-update database snapshots.
  ls -1t "$BACKUPS_DIR"/control-plane-*.db 2>/dev/null | tail -n +4 | xargs -r rm -f -- || true
  echo "${C_OK}Updated to v$(app_version)${C_0} ($(git -C "$APP_DIR" rev-parse --short=12 HEAD))."
}

cmd_version() {
  echo "FleetPanel v$(app_version) ($(git -C "$APP_DIR" rev-parse --short=12 HEAD 2>/dev/null || echo unknown)), channel $(current_ref)"
}

# Validates REF against the repository and makes it the update channel.
set_channel() {
  local ref="$1" url
  [[ $ref =~ $REF_RE ]] || die "invalid channel: $ref"
  url="$(git -C "$APP_DIR" remote get-url origin)"
  git ls-remote --exit-code "$url" "refs/heads/$ref" "refs/tags/$ref" >/dev/null 2>&1 \
    || die "'$ref' is neither a branch nor a release of $url"
  printf '%s\n' "$ref" > "$REF_FILE"
}

# Released tags, newest first; pre-releases (v0.4.0-beta.1) sort before their release.
release_tags() {
  local url
  url="$(git -C "$APP_DIR" remote get-url origin)"
  git ls-remote --tags --refs "$url" 2>/dev/null | awk -F/ '{print $NF}' | grep -E "$REF_RE" \
    | sed 's/-/~/' | sort -V -r | sed 's/~/-/' | head -n "${1:-10}" || true
}

# Menu: update now, or first pick another channel (main / dev / one release) from a list.
update_menu() {
  local current choice ref="" tags=() i
  current="$(current_ref)"
  echo
  echo "${C_B}Version${C_0} v$(app_version) · channel ${C_B}$current${C_0}"
  echo "  1) Update now"
  echo "  2) Change channel"
  echo "  0) Back"
  case "$(ask 'Choose: ')" in
    1) (cmd_update) || true; return 0 ;;
    2) ;;
    *) return 0 ;;
  esac
  echo
  echo "  1) main   stable (recommended)"
  echo "  2) dev    test builds, may have bugs"
  echo "  3) a specific version"
  echo "  0) back"
  choice="$(ask 'Choose: ')"
  case "$choice" in
    1) ref=main ;;
    2) ref=dev ;;
    3)
      mapfile -t tags < <(release_tags 10)
      (( ${#tags[@]} )) || { echo "No releases found."; return 0; }
      for i in "${!tags[@]}"; do
        printf '  %2d) %s%s\n' "$((i + 1))" "${tags[$i]}" "$([[ ${tags[$i]} == *-* ]] && echo '  (test)')"
      done
      choice="$(ask 'Choose: ')"
      [[ $choice =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#tags[@]} )) || return 0
      ref="${tags[$((choice - 1))]}"
      ;;
    *) return 0 ;;
  esac
  [[ $ref == "$current" ]] || (set_channel "$ref") || return 0
  if [[ "$(ask "Update now? [Y/n] ")" =~ ^[Nn] ]]; then
    echo "Channel: $ref (applied on the next update)."
  else
    (cmd_update) || true
  fi
}

cmd_channel() {
  local ref="${1:-}"
  if [[ -z $ref ]]; then
    echo "Channel: $(current_ref)   (main = stable, dev = test builds, vX.Y.Z = one release)"
    echo "Releases: $(release_tags 8 | tr '\n' ' ')"
    return 0
  fi
  set_channel "$ref"
  echo "Channel: $ref. Apply it with: sudo fleetpanel update"
}

# ---------------------------------------------------------------------------
# Status and diagnostics

cmd_status() {
  local state
  state="$(systemctl is-active "$SERVICE" 2>/dev/null || true)"
  if [[ $state == active ]]; then echo "Panel service : ${C_OK}running${C_0}"; else echo "Panel service : ${C_BAD}${state:-unknown}${C_0}"; fi
  if curl -fsS "$HEALTH_URL" >/dev/null 2>&1; then echo "Health check  : ${C_OK}ok${C_0}"; else echo "Health check  : ${C_BAD}FAILED${C_0}"; fi
  echo "Version       : v$(app_version) ($(current_ref))"
  echo
  if [[ $EUID -eq 0 ]]; then app_cli list-instances; else echo "(run with sudo to list instances)"; fi
  [[ $state == active ]]
}

D_PASS=0 D_WARN=0 D_FAIL=0
pass() { D_PASS=$((D_PASS + 1)); printf '  %s[PASS]%s %s\n' "$C_OK" "$C_0" "$*"; }
warn() { D_WARN=$((D_WARN + 1)); printf '  %s[WARN]%s %s\n' "$C_WARN" "$C_0" "$*"; }
fail() { D_FAIL=$((D_FAIL + 1)); printf '  %s[FAIL]%s %s\n' "$C_BAD" "$C_0" "$*"; }

cmd_doctor() {
  local php out ver free_kb total_mb mode owner size ext missing errors line
  echo "${C_B}FleetPanel doctor${C_0} — v$(app_version), channel $(current_ref)"
  echo

  if systemctl is-active --quiet "$SERVICE"; then pass "Panel service is running"; else fail "Panel service is not running (sudo fleetpanel start; sudo fleetpanel logs)"; fi
  if out="$(curl -fsS "$HEALTH_URL" 2>/dev/null)"; then pass "API answers on 127.0.0.1:3000 ($out)"; else fail "API does not answer on 127.0.0.1:3000"; fi

  if out="$(nginx -t 2>&1)"; then pass "nginx configuration is valid"; else fail "nginx configuration is invalid: $(printf '%s' "$out" | grep -E 'emerg|error' | tail -n 1)"; fi
  # nginx only warns about duplicate server names, then serves the domain from whichever site sorts first.
  local dup
  # || true: no match is the normal case, and set -e would otherwise end doctor right here.
  dup="$(printf '%s' "$out" | grep -o 'conflicting server name "[^"]*"' | cut -d'"' -f2 | sort -u | tr '\n' ' ' || true)"
  if [[ -n $dup ]]; then
    warn "Domains served by more than one nginx site (requests may reach the wrong one): ${dup% } — check: grep -l <domain> /etc/nginx/sites-enabled/*"
  fi
  php="$(cat /etc/fleetpanel/php-version 2>/dev/null || true)"
  if [[ -n $php ]] && out="$("php-fpm$php" -t 2>&1)"; then pass "php-fpm $php configuration is valid"; else fail "php-fpm configuration is invalid or PHP version unknown: $(printf '%s' "$out" | tail -n 1)"; fi

  if mysqladmin --protocol=socket -u root ping >/dev/null 2>&1; then pass "MySQL/MariaDB is reachable"; else fail "MySQL/MariaDB is not reachable over the local socket"; fi

  if [[ -f $KEY_FILE ]]; then
    mode="$(stat -c %a "$KEY_FILE")" owner="$(stat -c %U "$KEY_FILE")" size="$(stat -c %s "$KEY_FILE")"
    if [[ $mode == 600 && $owner == "$SERVICE_USER" && $size == 32 ]]; then
      pass "Master key is private (600, $owner, 32 bytes)"
    else
      fail "Master key has mode $mode, owner $owner, $size bytes (expected 600, $SERVICE_USER, 32)"
    fi
  else
    fail "Master key $KEY_FILE is missing: stored bot tokens cannot be decrypted"
  fi
  if ls "$BACKUPS_DIR"/control-plane-*.tar.gz >/dev/null 2>&1; then
    pass "A control-plane backup exists (copy it off the server)"
  else
    warn "No control-plane backup yet: run 'sudo fleetpanel backup' and keep the file off this server"
  fi

  if [[ -x $HELPER ]] && visudo -cf /etc/sudoers.d/fleetpanel >/dev/null 2>&1; then pass "Privileged helper and sudoers rule are installed"; else fail "Privileged helper or /etc/sudoers.d/fleetpanel is missing or invalid"; fi

  free_kb="$(df -Pk "$FLEET_DIR" | awk 'NR==2 {print $4}')"
  if (( free_kb < 512 * 1024 )); then fail "Only $((free_kb / 1024)) MB free on $FLEET_DIR"
  elif (( free_kb < 2 * 1024 * 1024 )); then warn "Only $((free_kb / 1024)) MB free on $FLEET_DIR"
  else pass "$((free_kb / 1024 / 1024)) GB free on $FLEET_DIR"; fi

  total_mb="$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)"
  if (( total_mb < 900 )); then warn "${total_mb} MB RAM (1 GB+ recommended)"; else pass "${total_mb} MB RAM"; fi

  if node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>20||(a===20&&b>=19)?0:1)' 2>/dev/null; then pass "Node.js $(node -v)"; else fail "Node.js $(node -v 2>/dev/null || echo missing) (need >= 20.19)"; fi

  if php -r 'exit(PHP_VERSION_ID >= 80200 ? 0 : 1);' 2>/dev/null; then
    missing=""
    for ext in mbstring dom pdo_mysql mysqli curl zip gd intl bcmath; do
      php -m 2>/dev/null | grep -qix "$ext" || missing="$missing $ext"
    done
    if [[ -z $missing ]]; then pass "PHP $(php -r 'echo PHP_VERSION;') with required extensions"; else fail "PHP is missing extensions:$missing"; fi
  else
    fail "PHP $(php -r 'echo PHP_VERSION;' 2>/dev/null || echo missing) (bots need >= 8.2)"
  fi
  if command -v composer >/dev/null 2>&1; then pass "Composer is installed"; else fail "Composer is missing (apt-get install composer)"; fi

  if systemctl is-active --quiet certbot.timer 2>/dev/null || [[ -f /etc/cron.d/certbot ]]; then pass "Certificate auto-renewal is scheduled"; else warn "No certbot renewal timer found: certificates will expire after 90 days"; fi

  if ufw_active; then
    out="$(ufw status 2>/dev/null)"
    if grep -qE '^(80(/tcp)?|Nginx Full|Nginx HTTP) .*ALLOW' <<<"$out" && grep -qE '^(443(/tcp)?|Nginx Full|Nginx HTTPS) .*ALLOW' <<<"$out"; then
      pass "Firewall (ufw) is active and allows ports 80 and 443"
    else
      warn "Firewall (ufw) is active but ports 80/443 may be closed: certificates and webhooks need them (sudo fleetpanel firewall enable)"
    fi
  elif systemctl is-active --quiet firewalld 2>/dev/null; then
    pass "Firewall (firewalld) is active"
  else
    warn "No firewall is active (optional): sudo fleetpanel firewall enable"
  fi

  if [[ -f $DATA_DIR/fleetpanel.db ]]; then
    errors=0
    while IFS=$'\t' read -r slug provider _ status _; do
      [[ $status == error ]] && { errors=$((errors + 1)); warn "Instance $slug is in the error state (see the panel for the reason)"; }
      # PHP bots: their own cron dispatcher runs from a FleetPanel timer (expiry jobs, payments, backups).
      if [[ $status == running && ( $provider == mirza || $provider == faoxima ) ]]; then
        if systemctl is-active --quiet "fleetpanel-cron-$slug.timer"; then
          pass "Cron jobs of $slug are scheduled"
        else
          errors=$((errors + 1))
          fail "Cron jobs of $slug are not scheduled (restart the panel: sudo fleetpanel restart)"
        fi
      fi
      # Service bots (Python) run as their own systemd unit: a running bot must have it active.
      if [[ $status == running && -f /etc/systemd/system/fleetpanel-bot-$slug.service ]]; then
        if systemctl is-active --quiet "fleetpanel-bot-$slug.service"; then
          pass "Bot service of $slug is running"
        else
          errors=$((errors + 1))
          fail "Bot service of $slug is not running (journalctl -u fleetpanel-bot-$slug -n 50)"
        fi
      fi
    done < <(app_cli list-instances --tsv 2>/dev/null || true)
    line="$(app_cli list-instances --tsv 2>/dev/null | wc -l || echo 0)"
    (( errors == 0 )) && pass "$line instance(s), none in the error state"
  else
    fail "Control-plane database $DATA_DIR/fleetpanel.db is missing"
  fi

  echo
  echo "Summary: ${C_OK}$D_PASS passed${C_0}, ${C_WARN}$D_WARN warnings${C_0}, ${C_BAD}$D_FAIL failed${C_0}"
  (( D_FAIL == 0 ))
}

cmd_logs() {
  local lines=100 follow=() unit="$SERVICE"
  for arg in "$@"; do
    case "$arg" in
      -f|--follow) follow=(-f) ;;
      *)
        if [[ $arg =~ ^[0-9]{1,6}$ ]]; then lines="$arg"
        # A Python bot logs to the journal under its own unit; a PHP bot's cron jobs under theirs.
        elif [[ $arg =~ ^[a-z][a-z0-9-]{1,27}[a-z0-9]$ ]]; then
          if [[ -f /etc/systemd/system/fleetpanel-bot-$arg.service ]]; then
            unit="fleetpanel-bot-$arg.service"
          elif [[ -f /etc/systemd/system/fleetpanel-cron-$arg.service ]]; then
            unit="fleetpanel-cron-$arg.service"
          else
            die "'$arg' has no service log yet (created at the end of its installation). Installation errors are in the panel and in: sudo fleetpanel logs"
          fi
        else die "usage: fleetpanel logs [SLUG] [N] [-f]   (SLUG: a Python bot)"; fi
        ;;
    esac
  done
  journalctl -u "$unit" -n "$lines" --no-pager "${follow[@]}"
}

# ---------------------------------------------------------------------------
# Backups

cmd_backups() {
  app_cli list-backups "$@"
  echo
  echo "Control-plane backups ($BACKUPS_DIR):"
  ls -1t "$BACKUPS_DIR"/control-plane-*.tar.gz 2>/dev/null | sed 's/^/  /' || echo "  none"
}

cmd_backup() {
  if [[ -n ${1:-} ]]; then
    app_cli backup-instance "$1"
    return
  fi
  local file
  file="$(app_cli backup-control-plane "$BACKUPS_DIR")"
  echo "Backup: $file"
  echo "It contains the master key: keep a copy off this server and private."
}

restore_control_plane() {
  local file="$1" work entries safety
  [[ -f $file ]] || die "file not found: $file"
  entries="$(tar -tzf "$file" | sort | tr '\n' ' ')"
  [[ $entries == "fleetpanel.db manifest.json master.key " ]] || die "not a FleetPanel control-plane backup (contents: $entries)"
  echo "This replaces the panel database (administrators, instances, audit log) and the master key"
  echo "with the contents of $(basename "$file"). Bot files and bot databases are not touched."
  [[ "$(ask 'Type RESTORE to continue: ')" == RESTORE ]] || die "aborted"

  safety="$(app_cli backup-control-plane "$BACKUPS_DIR")"
  echo "Safety backup of the current state: $safety"
  work="$(mktemp -d)"
  # The extracted copy holds the master key: remove it however this command ends (die exits).
  RESTORE_WORK="$work"
  trap 'rm -rf "$RESTORE_WORK" "${FLEET_WORK:-}"' EXIT
  tar -xzf "$file" -C "$work" --no-same-owner
  # Runs as root: a crafted archive could ship these names as symlinks (e.g. to /etc/shadow).
  local f
  for f in fleetpanel.db master.key manifest.json; do
    [[ -f $work/$f && ! -L $work/$f ]] || die "$f in the backup is not a regular file"
  done
  [[ "$(stat -c %s "$work/master.key")" == 32 ]] || die "the backup's master key is not 32 bytes"

  systemctl stop "$SERVICE"
  copy_db "$work/fleetpanel.db" "$DATA_DIR/fleetpanel.db"
  install -o "$SERVICE_USER" -g "$SERVICE_USER" -m 0600 "$work/master.key" "$KEY_FILE"
  systemctl start "$SERVICE"
  if healthy; then
    echo "Control plane restored."
  else
    echo "The panel did not start after the restore; reverting to the safety backup." >&2
    systemctl stop "$SERVICE"
    tar -xzf "$safety" -C "$work" --no-same-owner
    copy_db "$work/fleetpanel.db" "$DATA_DIR/fleetpanel.db"
    install -o "$SERVICE_USER" -g "$SERVICE_USER" -m 0600 "$work/master.key" "$KEY_FILE"
    systemctl start "$SERVICE"
    die "restore failed and was reverted. See: sudo fleetpanel logs"
  fi
}

# An encrypted backup (.fleet, e.g. from Telegram): decrypt with the recovery passphrase, then
# restore it like a local control-plane backup.
restore_fleet() {
  local file="$1"
  [[ -f $file ]] || die "file not found: $file"
  FLEET_WORK="$(mktemp -d)"
  trap 'rm -rf "$FLEET_WORK"' EXIT
  chown "$SERVICE_USER" "$FLEET_WORK"
  install -o "$SERVICE_USER" -m 0600 "$file" "$FLEET_WORK/backup.fleet"
  app_cli decrypt-backup "$FLEET_WORK/backup.fleet" "$FLEET_WORK/control-plane.tar.gz" </dev/tty \
    || die "could not decrypt the backup"
  restore_control_plane "$FLEET_WORK/control-plane.tar.gz"
  echo "Bots whose files are not on this server are marked for Repair in the panel."
}

cmd_restore() {
  local target="${1:-}"
  [[ -n $target ]] || die "usage: fleetpanel restore <backup.fleet | control-plane .tar.gz | instance backup id>  (see: fleetpanel backups)"
  if [[ $target == *.fleet ]]; then
    restore_fleet "$target"
  elif [[ $target == *.tar.gz ]]; then
    restore_control_plane "$target"
  else
    echo "Restoring instance backup $target. The bot is briefly offline; a safety backup is taken first."
    [[ "$(ask 'Continue? [y/N] ')" =~ ^[Yy]$ ]] || die "aborted"
    app_cli restore-instance "$target"
  fi
}

# ---------------------------------------------------------------------------
# Uninstall

cmd_uninstall() {
  local mode instances=() slug db user
  echo "${C_B}Uninstall FleetPanel${C_0}"
  echo "  1) Standard: remove the panel, its service, CLI and root helper."
  echo "     Bots keep running; their files, databases and all backups stay in $FLEET_DIR."
  echo "  2) Full purge: ALSO delete every bot (files, databases, Linux users) and all backups."
  mode="$(ask 'Choose 1 or 2 (anything else cancels): ')"
  case "$mode" in
    1) ;;
    2)
      echo "${C_BAD}This permanently deletes every bot instance and its database. It cannot be undone.${C_0}"
      [[ "$(ask "Type '$PURGE_PHRASE' to continue: ")" == "$PURGE_PHRASE" ]] || die "aborted"
      mapfile -t instances < <(app_cli list-instances --tsv 2>/dev/null || true)
      echo "Unregistering Telegram webhooks..."
      app_cli delete-webhooks || true
      ;;
    *) echo "Cancelled."; return 0 ;;
  esac

  if [[ $mode == 1 ]]; then
    echo "Taking a final control-plane backup..."
    app_cli backup-control-plane "$BACKUPS_DIR" || echo "(backup failed; continuing)" >&2
  fi

  systemctl disable --now "$SERVICE" >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/fleetpanel.service
  systemctl daemon-reload
  rm -f "$PANEL_LINK" "$PANEL_SITE"

  if [[ $mode == 2 ]]; then
    for line in "${instances[@]}"; do
      IFS=$'\t' read -r slug _ _ _ db user <<<"$line"
      echo "Removing instance $slug..."
      "$HELPER" instance-remove "$slug" || echo "  (could not remove all files of $slug)" >&2
      "$HELPER" db-drop "$db" "$user" || echo "  (could not drop database $db)" >&2
    done
    rm -f /etc/nginx/conf.d/fleetpanel.conf
    rm -rf /usr/local/lib/fleetpanel
  fi
  if nginx -t >/dev/null 2>&1; then systemctl reload nginx || true; fi

  rm -f /etc/sudoers.d/fleetpanel "$HELPER"
  rm -rf "$APP_DIR" "$FLEET_DIR/app.new" "$FLEET_DIR/app.prev" "$FLEET_DIR/app.failed"

  if [[ $mode == 2 ]]; then
    rm -rf "$FLEET_DIR" /etc/fleetpanel
    userdel "$SERVICE_USER" >/dev/null 2>&1 || true
    groupdel "$SERVICE_USER" >/dev/null 2>&1 || true
    echo "FleetPanel and all of its bots were removed. Let's Encrypt certificates are left in /etc/letsencrypt."
  else
    echo "FleetPanel was removed. Kept: $FLEET_DIR/{data,config,backups,instances}, /etc/fleetpanel."
    echo "Bots keep running. Reinstall any time with the install script to manage them again."
  fi
  rm -f /usr/local/bin/fleetpanel
}

# ---------------------------------------------------------------------------
# Firewall (ufw, optional)

UFW_PING_RULES=(/etc/ufw/before.rules /etc/ufw/before6.rules)
# Services that should never face the internet; closed unless the operator says otherwise.
PRIVATE_PORTS=' 3306 33060 5432 6379 11211 27017 '

ufw_active() { command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; }
ping_blocked() { grep -qE -- '--icmp-type echo-request -j DROP' /etc/ufw/before.rules 2>/dev/null; }

# sshd's configured ports, plus the port this session came in on, so enabling never locks the operator out.
ssh_ports() {
  {
    sshd -T 2>/dev/null | awk '$1 == "port" {print $2}' || true
    [[ -n ${SSH_CONNECTION:-} ]] && awk '{print $4}' <<<"$SSH_CONNECTION"
  } | grep -E '^[0-9]{1,5}$' | sort -un || true
}

# The panel's own port when it runs in IP mode (domain mode uses 80/443).
panel_ports() {
  grep -oE 'listen +(\[::\]:)?[0-9]+' "$PANEL_SITE" 2>/dev/null | grep -oE '[0-9]+$' | sort -un || true
}

# TCP ports listening on a non-loopback address.
public_tcp_ports() {
  ss -Hltn 2>/dev/null | awk '{print $4}' | grep -vE '^(127\.|\[::1\]|\[::ffff:127\.)|%lo:' \
    | sed -E 's/.*:([0-9]+)$/\1/' | grep -E '^[0-9]+$' | sort -un || true
}

listener_name() {
  ss -Hltnp "sport = :$1" 2>/dev/null | grep -oE 'users:\(\("[^"]+"' | head -n 1 | cut -d'"' -f2 || true
}

set_ping() {
  local from=DROP to=ACCEPT file
  [[ $1 == block ]] && from=ACCEPT to=DROP
  for file in "${UFW_PING_RULES[@]}"; do
    [[ -f $file ]] || continue
    [[ -f $file.fleetpanel.bak ]] || cp -p "$file" "$file.fleetpanel.bak"
    # Only echo requests: other ICMP types (unreachable, IPv6 neighbour discovery) must keep working.
    sed -i -E "/--icmp(v6)?-type echo-request /s/-j $from\$/-j $to/" "$file"
  done
}

firewall_status() {
  if ! command -v ufw >/dev/null 2>&1; then
    echo "ufw is not installed. Set up a firewall with: sudo fleetpanel firewall enable"
    return 0
  fi
  ufw status verbose
  if ping_blocked; then echo "Ping: blocked"; else echo "Ping: allowed"; fi
}

firewall_enable() {
  local ping=$1 yes=$2 port name answer
  local -a ssh panel allow
  if systemctl is-active --quiet firewalld 2>/dev/null; then
    die "firewalld manages this server's firewall; allow ports 80 and 443 there instead"
  fi
  if ! command -v ufw >/dev/null 2>&1; then
    [[ $yes == 1 || "$(ask 'ufw is not installed. Install it now? [y/N] ')" =~ ^[Yy]$ ]] || die "aborted"
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ufw >/dev/null
  fi

  mapfile -t ssh < <(ssh_ports)
  (( ${#ssh[@]} )) || ssh=(22)
  mapfile -t panel < <(panel_ports)
  allow=("${ssh[@]}" 80 443 "${panel[@]}")

  # Anything else that listens publicly may be a service the operator relies on: ask about each one.
  for port in $(public_tcp_ports); do
    [[ " ${allow[*]} " == *" $port "* ]] && continue
    name="$(listener_name "$port")"
    if [[ $PRIVATE_PORTS == *" $port "* ]]; then
      answer="$( [[ $yes == 1 ]] || ask "Port $port/tcp (${name:-unknown}) is a database port open to the internet. Keep it open? [y/N] ")"
      [[ $answer =~ ^[Yy]$ ]] && allow+=("$port")
    else
      answer="$( [[ $yes == 1 ]] || ask "Port $port/tcp (${name:-unknown}) is open to the internet. Keep it open? [Y/n] ")"
      [[ $answer =~ ^[Nn]$ ]] || allow+=("$port")
    fi
  done
  mapfile -t allow < <(printf '%s\n' "${allow[@]}" | sort -un)

  if [[ -z $ping && $yes != 1 ]]; then
    [[ "$(ask 'Block ping (ICMP echo) from the internet? [y/N] ')" =~ ^[Yy]$ ]] && ping=block
  fi

  echo
  echo "Incoming traffic will be denied except TCP ports: ${allow[*]} (SSH: ${ssh[*]})."
  echo "Existing ufw rules are kept. Outgoing traffic stays allowed."
  [[ -n $ping ]] && echo "Ping will be ${ping}ed."
  [[ $yes == 1 || "$(ask 'Apply? [y/N] ')" =~ ^[Yy]$ ]] || { echo "Cancelled."; return 0; }

  for port in "${allow[@]}"; do
    ufw allow "$port/tcp" comment 'FleetPanel' >/dev/null
  done
  ufw default deny incoming >/dev/null
  ufw default allow outgoing >/dev/null
  [[ -n $ping ]] && set_ping "$ping"
  if ufw_active; then ufw reload >/dev/null; else ufw --force enable >/dev/null; fi
  echo "${C_OK}Firewall is active.${C_0}"
  echo
  firewall_status
}

cmd_firewall() {
  local action="${1:-status}" ping="" yes=0 arg
  (( $# )) && shift
  for arg in "$@"; do
    case $arg in
      --block-ping) ping=block ;;
      --allow-ping) ping=allow ;;
      -y|--yes) yes=1 ;;
      *) die "unknown option: $arg" ;;
    esac
  done
  case $action in
    status) firewall_status ;;
    enable) firewall_enable "$ping" "$yes" ;;
    disable)
      ufw_active || { echo "The firewall is not active."; return 0; }
      [[ $yes == 1 || "$(ask 'Disable the firewall? All ports become reachable. [y/N] ')" =~ ^[Yy]$ ]] || { echo "Cancelled."; return 0; }
      ufw disable
      ;;
    *) die "usage: fleetpanel firewall [status | enable [--block-ping|--allow-ping] [--yes] | disable [--yes]]" ;;
  esac
}

# ---------------------------------------------------------------------------
# Interactive menu

# The panel's log, or a bot's own log (Python bots; the cron jobs of PHP bots).
logs_menu() {
  local bots=() i choice
  mapfile -t bots < <(ls /etc/systemd/system/fleetpanel-bot-*.service /etc/systemd/system/fleetpanel-cron-*.service 2>/dev/null \
    | sed -E 's#.*/fleetpanel-(bot|cron)-(.*)\.service$#\2#' | sort -u)
  if (( ${#bots[@]} == 0 )); then
    cmd_logs 50
    return 0
  fi
  echo "  1) Panel"
  for i in "${!bots[@]}"; do printf '  %d) %s\n' "$((i + 2))" "${bots[$i]}"; done
  echo "  0) Back"
  choice="$(ask 'Choose: ')"
  if [[ $choice == 1 ]]; then
    cmd_logs 50
  elif [[ $choice =~ ^[0-9]+$ ]] && (( choice >= 2 && choice <= ${#bots[@]} + 1 )); then
    cmd_logs "${bots[$((choice - 2))]}" 50
  fi
}

backups_menu() {
  echo "  1) List backups"
  echo "  2) Back up the panel now"
  echo "  3) Restore a backup"
  echo "  0) Back"
  case "$(ask 'Choose: ')" in
    1) cmd_backups || true ;;
    2) cmd_backup || true ;;
    3)
      cmd_backups || true
      (cmd_restore "$(ask 'Backup file (.fleet / .tar.gz) or instance backup id: ')") || true
      ;;
  esac
}

menu() {
  [[ -t 0 || -r /dev/tty ]] || { usage; exit 0; }
  need_root
  local choice state title width border
  while true; do
    state="$(systemctl is-active "$SERVICE" 2>/dev/null || true)"
    echo
    # The box grows with the title (long channel names), padded by characters, not bytes.
    title="FleetPanel v$(app_version)  ·  channel $(current_ref)"
    width=$(( ${#title} > 40 ? ${#title} : 40 ))
    border="$(printf '─%.0s' $(seq 1 $((width + 2))))"
    echo "${C_B}╭${border}╮${C_0}"
    printf '%s│%s %s%*s %s│%s\n' "$C_B" "$C_0" "$title" $((width - ${#title})) '' "$C_B" "$C_0"
    echo "${C_B}╰${border}╯${C_0}"
    if [[ $state == active ]]; then echo "  Panel: ${C_OK}● running${C_0}"; else echo "  Panel: ${C_BAD}● ${state:-stopped}${C_0}"; fi
    cat <<EOF

  1) Status        5) Update
  2) Doctor        6) Firewall
  3) Logs          7) Restart panel
  4) Backups       8) Uninstall
  0) Exit
EOF
    choice="$(ask $'\nChoose: ')"
    case "$choice" in
      1) cmd_status || true ;;
      2) cmd_doctor || true ;;
      3) logs_menu || true ;;
      4) backups_menu || true ;;
      5) update_menu || true ;;
      6) firewall_status; [[ "$(ask 'Set up or update the firewall now? [y/N] ')" =~ ^[Yy]$ ]] && { (firewall_enable "" 0) || true; } ;;
      7) systemctl restart "$SERVICE" && healthy && echo "Restarted." || echo "${C_BAD}The panel did not come back; see: sudo fleetpanel logs${C_0}" ;;
      8) cmd_uninstall; exit 0 ;;
      0|q|"") exit 0 ;;
      *) echo "Unknown choice." ;;
    esac
  done
}

case "${1:-}" in
  "") menu ;;
  status) cmd_status ;;
  doctor) need_root doctor; cmd_doctor ;;
  start) need_root start; systemctl start "$SERVICE"; healthy && echo "Panel started." || die "the panel did not become healthy; see: sudo fleetpanel logs" ;;
  stop) need_root stop; systemctl stop "$SERVICE"; echo "Panel stopped. Bots keep running." ;;
  restart) need_root restart; systemctl restart "$SERVICE"; healthy && echo "Panel restarted." || die "the panel did not become healthy; see: sudo fleetpanel logs" ;;
  logs) shift; cmd_logs "$@" ;;
  instances) need_root instances; app_cli list-instances ;;
  backups) need_root backups; shift; cmd_backups "$@" ;;
  backup) need_root backup; shift; cmd_backup "$@" ;;
  restore) need_root restore; shift; cmd_restore "$@" ;;
  admins) need_root admins; app_cli list-admins ;;
  create-admin) need_root create-admin; shift; app_cli create-admin "$@" ;;
  reset-password) need_root reset-password; shift; app_cli reset-password "$@" ;;
  version) cmd_version ;;
  channel) need_root channel; shift; cmd_channel "$@" ;;
  update) need_root update; cmd_update ;;
  firewall) need_root firewall; shift; cmd_firewall "$@" ;;
  uninstall) need_root uninstall; cmd_uninstall ;;
  -h|--help|help) usage ;;
  *) echo "Unknown command: $1" >&2; usage; exit 2 ;;
esac
