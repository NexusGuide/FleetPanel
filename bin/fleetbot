#!/usr/bin/env bash
# Fleetbot operator CLI. Most commands require root.
set -euo pipefail

FLEET_DIR=/opt/fleetbot
APP_DIR="$FLEET_DIR/app"
DATA_DIR="$FLEET_DIR/data"
SERVICE_USER=fleetbot
HEALTH_URL=http://127.0.0.1:3000/api/health

usage() {
  cat <<'EOF'
Usage: fleetbot <command>

  status                     Service status and health check
  logs [N]                   Show the last N log lines (default 100)
  restart                    Restart the control plane
  admins                     List administrators
  create-admin USER [--role ROLE]
  reset-password USER        Set a new password and revoke all of USER's sessions
  update                     Pull, rebuild and restart; rolls back if the health check fails
EOF
}

need_root() { [[ $EUID -eq 0 ]] || { echo "This command needs root: sudo fleetbot $*" >&2; exit 1; }; }
app_cli() { sudo -u "$SERVICE_USER" env "FLEET_DIR=$FLEET_DIR" node "$APP_DIR/dist/cli.js" "$@"; }

healthy() {
  local _
  for _ in $(seq 1 20); do
    curl -fsS "$HEALTH_URL" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

build() {
  (
    cd "$1"
    echo "Installing dependencies (can take a few minutes; the panel keeps running)..."
    npm ci --no-audit --no-fund --loglevel=error --prefer-offline
    npm run build --silent
    npm prune --omit=dev --no-audit --no-fund --loglevel=error
  )
}

install_system_files() {
  local dir="$1"
  install -o root -g root -m 0755 "$dir/deploy/fleetbot-helper" /usr/local/sbin/fleetbot-helper
  # This script is still running: replace it by rename so bash keeps reading the old inode.
  install -o root -g root -m 0755 "$dir/bin/fleetbot" /usr/local/bin/fleetbot.new
  mv -f /usr/local/bin/fleetbot.new /usr/local/bin/fleetbot
}

# Copies the SQLite database together with its WAL, so committed-but-not-checkpointed
# writes survive (the service may have crashed instead of shutting down cleanly).
copy_db() {
  local from="$1" to="$2" ext
  for ext in "" -wal -shm; do
    rm -f "$to$ext"
    if [[ -f "$from$ext" ]]; then install -o "$SERVICE_USER" -g "$SERVICE_USER" -m 0600 "$from$ext" "$to$ext"; fi
  done
}

# Builds the new version in a staging directory while the panel keeps running, then
# swaps directories. Downtime is a few seconds, and rollback is a rename (no rebuild).
cmd_update() {
  local prev ref url snapshot
  local staging="$FLEET_DIR/app.new" previous="$FLEET_DIR/app.prev"
  ref="$(cat /etc/fleetbot/ref 2>/dev/null || echo main)"
  [[ $ref =~ ^[A-Za-z0-9._/-]{1,100}$ ]] || { echo "Invalid ref in /etc/fleetbot/ref" >&2; exit 1; }
  url="$(git -C "$APP_DIR" remote get-url origin)"
  prev="$(git -C "$APP_DIR" rev-parse HEAD)"

  echo "Fetching $ref..."
  rm -rf "$staging"
  git clone --quiet --depth 1 --branch "$ref" "$url" "$staging"
  if [[ "$(git -C "$staging" rev-parse HEAD)" == "$prev" ]]; then
    rm -rf "$staging"
    echo "Already up to date (${prev:0:12})."
    return 0
  fi
  if ! build "$staging"; then
    rm -rf "$staging"
    echo "Build failed; nothing was changed and the panel is still running ${prev:0:12}." >&2
    exit 1
  fi
  chown -R root:root "$staging"

  snapshot="$FLEET_DIR/backups/control-plane-$(date -u +%Y%m%dT%H%M%SZ).db"
  echo "Switching to the new version..."
  systemctl stop fleetbot.service
  copy_db "$DATA_DIR/fleetbot.db" "$snapshot"
  rm -rf "$previous"
  mv "$APP_DIR" "$previous"
  mv "$staging" "$APP_DIR"
  install_system_files "$APP_DIR"
  systemctl start fleetbot.service

  if ! healthy; then
    echo "Health check failed: rolling back to ${prev:0:12}" >&2
    journalctl -u fleetbot.service -n 15 --no-pager >&2 || true
    systemctl stop fleetbot.service || true
    rm -rf "$APP_DIR.failed"
    mv "$APP_DIR" "$APP_DIR.failed"
    mv "$previous" "$APP_DIR"
    install_system_files "$APP_DIR"
    copy_db "$snapshot" "$DATA_DIR/fleetbot.db"
    systemctl start fleetbot.service
    echo "Rolled back. The failed build is kept in $APP_DIR.failed for inspection." >&2
    exit 1
  fi
  rm -rf "$previous"
  echo "Updated ${prev:0:12} -> $(git -C "$APP_DIR" rev-parse --short=12 HEAD). DB snapshot: $snapshot"
}

case "${1:-}" in
  status)
    systemctl --no-pager status fleetbot.service || true
    if curl -fsS "$HEALTH_URL"; then echo; else echo "health check FAILED" >&2; exit 1; fi
    ;;
  logs)
    lines="${2:-100}"
    [[ $lines =~ ^[0-9]{1,6}$ ]] || { echo "N must be a number" >&2; exit 1; }
    journalctl -u fleetbot.service -n "$lines" --no-pager
    ;;
  restart) need_root restart; systemctl restart fleetbot.service ;;
  admins) need_root admins; app_cli list-admins ;;
  create-admin) need_root create-admin; shift; app_cli create-admin "$@" ;;
  reset-password) need_root reset-password; shift; app_cli reset-password "$@" ;;
  update) need_root update; cmd_update ;;
  ""|-h|--help|help) usage ;;
  *) echo "Unknown command: $1" >&2; usage; exit 2 ;;
esac
