#!/usr/bin/env bash
# fleetpanel-helper: the ONLY FleetPanel component that runs as root.
#
# The control plane (user "fleetpanel") calls it through a single sudoers rule:
#   fleetpanel ALL=(root) NOPASSWD: /usr/local/sbin/fleetpanel-helper
#
# Every argument is validated against a strict allowlist before it touches the
# system. Secrets (passwords, webhook secrets) are read from stdin, never argv,
# so they never show up in `ps` output or shell history.
set -euo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

readonly FLEET_DIR=/opt/fleetpanel
readonly INSTANCES_DIR="$FLEET_DIR/instances"
readonly CONTROL_USER=fleetpanel
readonly WEB_USER=www-data
readonly NGINX_AVAILABLE=/etc/nginx/sites-available
readonly NGINX_ENABLED=/etc/nginx/sites-enabled

readonly RE_SLUG='^[a-z][a-z0-9-]{1,27}[a-z0-9]$'
readonly RE_DOMAIN='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'
readonly RE_DB_IDENT='^fp_[a-z0-9_]{3,29}$'
readonly RE_HOOK='^[A-Za-z0-9_.-]{1,64}(/[A-Za-z0-9_.-]{1,64}){0,3}$'
readonly RE_SECRET='^[A-Za-z0-9_-]{32,256}$'
readonly RE_DB_PASSWORD='^[A-Za-z0-9]{24,128}$'
readonly RE_PHP_VERSION='^[0-9]\.[0-9]$'
readonly RE_EMAIL='^[^[:space:]@]+@[^[:space:]@]+\.[A-Za-z]{2,}$'

die() { echo "fleetpanel-helper: $*" >&2; exit 1; }
need_args() { [[ $1 -eq $2 ]] || die "expected $2 argument(s), got $1"; }

check_slug() { [[ $1 =~ $RE_SLUG ]] || die "invalid slug"; }
check_domain() { [[ ${#1} -le 253 && $1 =~ $RE_DOMAIN ]] || die "invalid domain"; }
check_db_ident() { [[ $1 =~ $RE_DB_IDENT ]] || die "invalid database identifier"; }
check_hook() { [[ $1 =~ $RE_HOOK && $1 != *..* ]] || die "invalid webhook path"; }

read_stdin_value() {
  local value=""
  IFS= read -r value || true
  printf '%s' "$value"
}

php_version() {
  local v
  v="$(cat /etc/fleetpanel/php-version 2>/dev/null || true)"
  [[ $v =~ $RE_PHP_VERSION ]] || die "PHP version is not configured in /etc/fleetpanel/php-version"
  printf '%s' "$v"
}

instance_user() { printf 'fp-%s' "$1"; }
instance_dir() { printf '%s/%s' "$INSTANCES_DIR" "$1"; }
pool_file() { printf '/etc/php/%s/fpm/pool.d/fleetpanel-%s.conf' "$2" "$1"; }
vhost_file() { printf '%s/fleetpanel-%s.conf' "$NGINX_AVAILABLE" "$1"; }
vhost_link() { printf '%s/fleetpanel-%s.conf' "$NGINX_ENABLED" "$1"; }

# Validates php-fpm and nginx config. On failure CONFIG_ERROR holds the tail of the
# tool's own output, so callers can report the real reason instead of a generic one.
CONFIG_ERROR=""
config_ok() {
  local out
  if ! out="$("php-fpm$1" -t 2>&1)"; then
    CONFIG_ERROR="php-fpm: $(printf '%s' "$out" | grep -v 'test is successful' | tail -n 3 | tr '\n' ' ')"
    return 1
  fi
  if ! out="$(nginx -t 2>&1)"; then
    CONFIG_ERROR="nginx: $(printf '%s' "$out" | grep -E 'emerg|error|failed' | tail -n 3 | tr '\n' ' ')"
    return 1
  fi
}

reload_services() {
  systemctl reload "php$1-fpm"
  systemctl reload nginx
}

# nginx's default server_names_hash_bucket_size (32 on many VPS CPUs) is too small
# once several domains are hosted ("could not build server_names_hash"). Raise it
# once, only if the admin has not set it already (setting it twice is an error).
ensure_server_names_hash() {
  local conf=/etc/nginx/conf.d/fleetpanel.conf
  [[ -f $conf ]] && return 0
  if nginx -T 2>/dev/null | grep -Eq '^[[:space:]]*server_names_hash_bucket_size[[:space:]]'; then return 0; fi
  printf '# Managed by FleetPanel: room for many/long server names\nserver_names_hash_bucket_size 128;\n' > "$conf"
  chmod 0644 "$conf"
}

ensure_instance_user() {
  local user="$1" dir="$2"
  if ! id -u "$user" >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir "$dir" --shell /usr/sbin/nologin "$user"
  fi
}

require_instance_dir() {
  local dir="$1"
  [[ -d $dir && ! -L $dir ]] || die "instance directory does not exist"
}

# instance-perms SLUG
# Bot files belong to the per-instance user; the control plane gets access
# through an ACL. nginx (www-data) may read files so it can serve the bot's
# static assets (CSS, JS, images) and redirect /dir to /dir/; the vhost denies
# secrets and data files, and config.php is additionally unreadable to it.
cmd_instance_perms() {
  need_args $# 1
  local slug="$1" user dir
  check_slug "$slug"
  user="$(instance_user "$slug")"
  dir="$(instance_dir "$slug")"
  require_instance_dir "$dir"
  ensure_instance_user "$user" "$dir"
  chown -R -P "$user:$user" "$dir"
  chmod -R u=rwX,g=rX,o= "$dir"
  setfacl -R -P -m "u:$CONTROL_USER:rwX,d:u:$CONTROL_USER:rwX,u:$WEB_USER:rX,d:u:$WEB_USER:rX" "$dir"
  if [[ -f $dir/config.php && ! -L $dir/config.php ]]; then setfacl -m "u:$WEB_USER:---" "$dir/config.php"; fi
}

# instance-create SLUG DOMAIN WEBHOOK_PATH AUTH   (stdin: webhook secret)
# AUTH is how Telegram proves a webhook call, matching what the bot itself checks:
#   header  X-Telegram-Bot-Api-Secret-Token
#   query   ?secret=... in the webhook URL
cmd_instance_create() {
  need_args $# 4
  local slug="$1" domain="$2" hook="$3" auth="$4" secret user dir php pool vhost link guard
  check_slug "$slug"
  check_domain "$domain"
  check_hook "$hook"
  secret="$(read_stdin_value)"
  [[ $secret =~ $RE_SECRET ]] || die "invalid webhook secret"
  case "$auth" in
    header) guard="if (\$http_x_telegram_bot_api_secret_token != \"$secret\") { return 403; }" ;;
    # The secret is in the URL: keep it out of the access log.
    query) guard="if (\$arg_secret != \"$secret\") { return 403; }
        access_log off;" ;;
    *) die "invalid webhook auth mode" ;;
  esac

  user="$(instance_user "$slug")"
  dir="$(instance_dir "$slug")"
  php="$(php_version)"
  pool="$(pool_file "$slug" "$php")"
  vhost="$(vhost_file "$slug")"
  link="$(vhost_link "$slug")"
  require_instance_dir "$dir"
  ensure_instance_user "$user" "$dir"
  ensure_server_names_hash

  cat > "$pool" <<EOF
; Managed by FleetPanel. Instance: $slug
[fleetpanel-$slug]
user = $user
group = $user
listen = /run/php/fleetpanel-$slug.sock
listen.owner = $WEB_USER
listen.group = $WEB_USER
listen.mode = 0660
pm = ondemand
pm.max_children = 8
pm.process_idle_timeout = 60s
pm.max_requests = 500
chdir = $dir
php_admin_value[open_basedir] = $dir/:/tmp/
php_admin_value[error_log] = $dir/php-error.log
php_admin_flag[log_errors] = on
php_admin_flag[display_errors] = off
EOF

  cat > "$vhost" <<EOF
# Managed by FleetPanel. Instance: $slug
server {
    listen 80;
    listen [::]:80;
    server_name $domain;
    root $dir;
    index index.php;
    client_max_body_size 32m;
    access_log /var/log/nginx/fleetpanel-$slug.access.log;
    error_log /var/log/nginx/fleetpanel-$slug.error.log;

    # Never serve dotfiles, dumps, logs, data files, configs or dependencies
    location ~ /\.(?!well-known/) { deny all; }
    location ~* \.(sql|log|ini|env|bak|sh|lock|md|json)\$ { deny all; }
    location ~ (^|/)error_log\$ { deny all; }
    location ~ ^/(config\.php|config/|vendor/|db/|logs/) { deny all; }

    # Telegram webhook: only requests carrying our secret reach PHP
    location = /$hook {
        $guard
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/fleetpanel-$slug.sock;
    }

    location ~ \.php\$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/fleetpanel-$slug.sock;
    }

    location / { try_files \$uri \$uri/ =404; }
}
EOF

  ln -sfn "$vhost" "$link"
  if ! config_ok "$php"; then
    rm -f "$pool" "$vhost" "$link"
    die "generated configuration failed validation; nothing was enabled. ${CONFIG_ERROR}"
  fi
  reload_services "$php"
}

# instance-enable SLUG
cmd_instance_enable() {
  need_args $# 1
  local slug="$1" php pool vhost link
  check_slug "$slug"
  php="$(php_version)"
  pool="$(pool_file "$slug" "$php")"
  vhost="$(vhost_file "$slug")"
  link="$(vhost_link "$slug")"
  [[ -f $vhost ]] || die "instance is not provisioned"
  if [[ -f "$pool.disabled" ]]; then mv -f "$pool.disabled" "$pool"; fi
  [[ -f $pool ]] || die "php-fpm pool is missing"
  ln -sfn "$vhost" "$link"
  if ! config_ok "$php"; then
    rm -f "$link"
    die "configuration test failed; instance left disabled. ${CONFIG_ERROR}"
  fi
  reload_services "$php"
}

# instance-disable SLUG
cmd_instance_disable() {
  need_args $# 1
  local slug="$1" php pool
  check_slug "$slug"
  php="$(php_version)"
  pool="$(pool_file "$slug" "$php")"
  rm -f "$(vhost_link "$slug")"
  if [[ -f $pool ]]; then mv -f "$pool" "$pool.disabled"; fi
  config_ok "$php" || die "configuration test failed after disabling. ${CONFIG_ERROR}"
  reload_services "$php"
}

# instance-remove SLUG  (idempotent)
cmd_instance_remove() {
  need_args $# 1
  local slug="$1" php pool user dir real
  check_slug "$slug"
  php="$(php_version)"
  pool="$(pool_file "$slug" "$php")"
  user="$(instance_user "$slug")"
  dir="$(instance_dir "$slug")"

  rm -f "$(vhost_link "$slug")" "$(vhost_file "$slug")" "$pool" "$pool.disabled"
  if config_ok "$php"; then reload_services "$php"; fi

  if [[ -L $dir ]]; then die "refusing to remove symlinked instance directory"; fi
  if [[ -e $dir ]]; then
    real="$(realpath -e -- "$dir")"
    [[ $real == "$INSTANCES_DIR/$slug" ]] || die "refusing to remove unexpected path"
    rm -rf --one-file-system -- "$dir"
  fi

  if id -u "$user" >/dev/null 2>&1; then
    pkill -u "$user" >/dev/null 2>&1 || true
    userdel "$user" >/dev/null 2>&1 || true
  fi
  if getent group "$user" >/dev/null 2>&1; then groupdel "$user" >/dev/null 2>&1 || true; fi
}

# db-create DB_NAME DB_USER   (stdin: password)  (idempotent, rotates password)
cmd_db_create() {
  need_args $# 2
  local db="$1" user="$2" password
  check_db_ident "$db"
  check_db_ident "$user"
  password="$(read_stdin_value)"
  [[ $password =~ $RE_DB_PASSWORD ]] || die "invalid database password"
  mysql --protocol=socket -u root <<SQL
CREATE DATABASE IF NOT EXISTS \`$db\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '$user'@'localhost' IDENTIFIED BY '$password';
ALTER USER '$user'@'localhost' IDENTIFIED BY '$password';
GRANT ALL PRIVILEGES ON \`$db\`.* TO '$user'@'localhost';
FLUSH PRIVILEGES;
SQL
}

# db-drop DB_NAME DB_USER  (idempotent)
cmd_db_drop() {
  need_args $# 2
  local db="$1" user="$2"
  check_db_ident "$db"
  check_db_ident "$user"
  mysql --protocol=socket -u root <<SQL
DROP DATABASE IF EXISTS \`$db\`;
DROP USER IF EXISTS '$user'@'localhost';
FLUSH PRIVILEGES;
SQL
}

# cert-issue DOMAIN
cmd_cert_issue() {
  need_args $# 1
  local domain="$1" email out
  check_domain "$domain"
  local args=(--nginx -d "$domain" --non-interactive --agree-tos --redirect --keep-until-expiring)
  email="$(cat /etc/fleetpanel/acme-email 2>/dev/null || true)"
  if [[ $email =~ $RE_EMAIL ]]; then
    args+=(--email "$email")
  else
    args+=(--register-unsafely-without-email)
  fi
  if ! out="$(certbot "${args[@]}" 2>&1)"; then
    printf '%s\n' "$out" | tail -n 5 >&2
    die "certificate issuance failed for $domain (does DNS point to this server and is port 80 reachable?)"
  fi
}

main() {
  [[ $EUID -eq 0 ]] || die "must run as root"
  local cmd="${1:-}"
  if [[ $# -gt 0 ]]; then shift; fi
  case "$cmd" in
    instance-create)  cmd_instance_create "$@" ;;
    instance-perms)   cmd_instance_perms "$@" ;;
    instance-enable)  cmd_instance_enable "$@" ;;
    instance-disable) cmd_instance_disable "$@" ;;
    instance-remove)  cmd_instance_remove "$@" ;;
    db-create)        cmd_db_create "$@" ;;
    db-drop)          cmd_db_drop "$@" ;;
    cert-issue)       cmd_cert_issue "$@" ;;
    *) die "unknown command '${cmd}'" ;;
  esac
}

main "$@"
