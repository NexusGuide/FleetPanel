#!/usr/bin/env bash
# fleetpanel-helper: the ONLY FleetPanel component that runs as root.
#
# The control plane (user "fleetpanel") calls it through a single sudoers rule:
#   fleetpanel ALL=(root) NOPASSWD: /usr/local/sbin/fleetpanel-helper
#
# Every argument is validated against a strict allowlist before it touches the
# system. Secrets (passwords, webhook secrets) are read from stdin, never argv,
# so they never show up in `ps` output or shell history.
set -euo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

readonly FLEET_DIR=/opt/fleetpanel
readonly INSTANCES_DIR="$FLEET_DIR/instances"
readonly CONTROL_USER=fleetpanel
readonly WEB_USER=www-data
readonly NGINX_AVAILABLE=/etc/nginx/sites-available
readonly NGINX_ENABLED=/etc/nginx/sites-enabled

readonly RE_SLUG='^[a-z][a-z0-9-]{1,27}[a-z0-9]$'
readonly RE_DOMAIN='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'
readonly RE_DB_IDENT='^fp_[a-z0-9_]{3,29}$'
readonly RE_HOOK='^[A-Za-z0-9_.-]{1,64}(/[A-Za-z0-9_.-]{1,64}){0,3}$'
readonly RE_SECRET='^[A-Za-z0-9_-]{32,256}$'
readonly RE_DB_PASSWORD='^[A-Za-z0-9]{24,128}$'
readonly RE_PHP_VERSION='^[0-9]\.[0-9]$'
readonly RE_EMAIL='^[^[:space:]@]+@[^[:space:]@]+\.[A-Za-z]{2,}$'
readonly RE_PORT='^2[0-9]{4}$'
readonly RE_ENV_LINE='^[A-Z][A-Z0-9_]{1,40}=[A-Za-z0-9_.:/@+%=?,-]{0,255}$'

# Service bots (Python): a systemd service per bot, its own Redis, nginx as reverse proxy.
readonly RUNTIME_DIR="$FLEET_DIR/runtime"
readonly ENV_DIR=/etc/fleetpanel/instances
readonly PYRUN=/usr/local/lib/fleetpanel/pyrun.py
readonly REDIS_SERVER=/usr/bin/redis-server
# Pinned toolchain; the checksums are those published with each release.
readonly UV_VERSION=0.11.31
readonly BUN_VERSION=1.4.2
readonly PYTHON_SERIES=3.14
# Only these keys may appear in a bot's environment: nothing that changes how programs load.
readonly ENV_KEYS=" BOT_TOKEN API_ID API_HASH ADMIN_ID SQLALCHEMY_DATABASE_URL FASTAPI_PORT REDIS_URL REDIS_NAMESPACE_PREFIX LOG_DIR TELETHON_SESSION_PATH WEBAPP_URL "

die() { echo "fleetpanel-helper: $*" >&2; exit 1; }
need_args() { [[ $1 -eq $2 ]] || die "expected $2 argument(s), got $1"; }

check_slug() { [[ $1 =~ $RE_SLUG ]] || die "invalid slug"; }
check_domain() { [[ ${#1} -le 253 && $1 =~ $RE_DOMAIN ]] || die "invalid domain"; }
check_db_ident() { [[ $1 =~ $RE_DB_IDENT ]] || die "invalid database identifier"; }
check_hook() { [[ $1 =~ $RE_HOOK && $1 != *..* ]] || die "invalid webhook path"; }

read_stdin_value() {
  local value=""
  IFS= read -r value || true
  printf '%s' "$value"
}

php_version() {
  local v
  v="$(cat /etc/fleetpanel/php-version 2>/dev/null || true)"
  [[ $v =~ $RE_PHP_VERSION ]] || die "PHP version is not configured in /etc/fleetpanel/php-version"
  printf '%s' "$v"
}

instance_user() { printf 'fp-%s' "$1"; }
instance_dir() { printf '%s/%s' "$INSTANCES_DIR" "$1"; }
pool_file() { printf '/etc/php/%s/fpm/pool.d/fleetpanel-%s.conf' "$2" "$1"; }
vhost_file() { printf '%s/fleetpanel-%s.conf' "$NGINX_AVAILABLE" "$1"; }
vhost_link() { printf '%s/fleetpanel-%s.conf' "$NGINX_ENABLED" "$1"; }
env_file() { printf '%s/%s.env' "$ENV_DIR" "$1"; }
bot_unit() { printf 'fleetpanel-bot-%s.service' "$1"; }
redis_unit() { printf 'fleetpanel-redis-%s.service' "$1"; }
unit_path() { printf '/etc/systemd/system/%s' "$1"; }
# A service bot is one whose environment file exists; it is written by root only.
is_service_instance() { [[ -f "$(env_file "$1")" ]]; }

nginx_ok() {
  local out
  if ! out="$(nginx -t 2>&1)"; then
    CONFIG_ERROR="nginx: $(printf '%s' "$out" | grep -E 'emerg|error|failed' | tail -n 3 | tr '\n' ' ')"
    return 1
  fi
}

# Validates php-fpm and nginx config. On failure CONFIG_ERROR holds the tail of the
# tool's own output, so callers can report the real reason instead of a generic one.
CONFIG_ERROR=""
config_ok() {
  local out
  if ! out="$("php-fpm$1" -t 2>&1)"; then
    CONFIG_ERROR="php-fpm: $(printf '%s' "$out" | grep -v 'test is successful' | tail -n 3 | tr '\n' ' ')"
    return 1
  fi
  if ! out="$(nginx -t 2>&1)"; then
    CONFIG_ERROR="nginx: $(printf '%s' "$out" | grep -E 'emerg|error|failed' | tail -n 3 | tr '\n' ' ')"
    return 1
  fi
}

reload_services() {
  systemctl reload "php$1-fpm"
  systemctl reload nginx
}

# nginx's default server_names_hash_bucket_size (32 on many VPS CPUs) is too small
# once several domains are hosted ("could not build server_names_hash"). Raise it
# once, only if the admin has not set it already (setting it twice is an error).
ensure_server_names_hash() {
  local conf=/etc/nginx/conf.d/fleetpanel.conf
  [[ -f $conf ]] && return 0
  if nginx -T 2>/dev/null | grep -Eq '^[[:space:]]*server_names_hash_bucket_size[[:space:]]'; then return 0; fi
  printf '# Managed by FleetPanel: room for many/long server names\nserver_names_hash_bucket_size 128;\n' > "$conf"
  chmod 0644 "$conf"
}

# domain_used_by DOMAIN [IGNORE_FILE]: prints the first enabled nginx site (other than
# IGNORE_FILE) whose server_name lists DOMAIN exactly. DOMAIN is pre-validated.
domain_used_by() {
  local domain="$1" ignore="${2:-}" f
  for f in "$NGINX_ENABLED"/*; do
    [[ -e $f && $f != "$ignore" ]] || continue
    if grep -qE "^[[:space:]]*server_name([[:space:]]+[^;[:space:]]+)*[[:space:]]+${domain//./\\.}([[:space:]]|;)" "$f"; then
      printf '%s' "$f"
      return 0
    fi
  done
}

ensure_instance_user() {
  local user="$1" dir="$2"
  if ! id -u "$user" >/dev/null 2>&1; then
    useradd --system --user-group --no-create-home --home-dir "$dir" --shell /usr/sbin/nologin "$user"
  fi
}

require_instance_dir() {
  local dir="$1"
  [[ -d $dir && ! -L $dir ]] || die "instance directory does not exist"
}

# instance-perms SLUG
# Bot files belong to the per-instance user; the control plane gets access
# through an ACL. nginx (www-data) may read files so it can serve the bot's
# static assets (CSS, JS, images) and redirect /dir to /dir/; the vhost denies
# secrets and data files, and config.php is additionally unreadable to it.
cmd_instance_perms() {
  need_args $# 1
  local slug="$1" user dir
  check_slug "$slug"
  user="$(instance_user "$slug")"
  dir="$(instance_dir "$slug")"
  require_instance_dir "$dir"
  ensure_instance_user "$user" "$dir"
  # The instances directory is writable by the control-plane user, so the path could be
  # swapped for a symlink after the check above (chmod follows symlink arguments). Work
  # from inside the directory instead: once it is our cwd, renaming the path is harmless.
  cd -P -- "$dir" || die "cannot enter instance directory"
  [[ "$(pwd -P)" == "$dir" ]] || die "instance directory moved during permission fix"
  chown -R -P "$user:$user" .
  chmod -R u=rwX,g=rX,o= .
  if is_service_instance "$slug"; then
    # nginx only proxies to a service bot; it never reads its files (sessions, Redis data).
    setfacl -R -P -b .
    setfacl -R -P -m "u:$CONTROL_USER:rwX,d:u:$CONTROL_USER:rwX" .
  else
    setfacl -R -P -m "u:$CONTROL_USER:rwX,d:u:$CONTROL_USER:rwX,u:$WEB_USER:rX,d:u:$WEB_USER:rX" .
    if [[ -f config.php && ! -L config.php ]]; then setfacl -m "u:$WEB_USER:---" config.php; fi
  fi
}

require_runtime() {
  [[ -x $RUNTIME_DIR/bin/uv && -x $RUNTIME_DIR/bin/bun && -f $PYRUN ]] || die "the Python runtime is not installed (runtime-python)"
}

# instance-run SLUG composer | SLUG php SCRIPT.php | SLUG python-deps | SLUG webapp-build | SLUG python-migrate
# Runs a bot's own install steps as the bot's Linux user, never as the control plane:
# a compromised upstream project or package then only reaches that one bot.
cmd_instance_run() {
  local slug="${1:-}" task="${2:-}" user dir home rc envf="" limit=900
  check_slug "$slug"
  user="$(instance_user "$slug")"
  dir="$(instance_dir "$slug")"
  require_instance_dir "$dir"
  id -u "$user" >/dev/null 2>&1 || die "instance user does not exist (run instance-perms first)"
  local cmd=()
  case "$task" in
    python-deps)
      need_args $# 2
      require_runtime
      # --frozen: exactly the versions (and hashes) in the project's uv.lock.
      cmd=("$RUNTIME_DIR/bin/uv" sync --frozen --no-dev --python "$PYTHON_SERIES")
      limit=1800
      ;;
    webapp-build)
      need_args $# 2
      require_runtime
      [[ -d $dir/frontend && ! -L $dir/frontend ]] || die "frontend directory not found"
      # bun skips dependency install scripts except for its built-in and the project's trusted lists.
      cmd=(bash -c 'cd frontend && "$0" install --frozen-lockfile && "$0" run build' "$RUNTIME_DIR/bin/bun")
      limit=1800
      ;;
    python-migrate)
      need_args $# 2
      is_service_instance "$slug" || die "the bot's environment is missing (instance-env)"
      [[ -x $dir/.venv/bin/alembic ]] || die "alembic is not installed (python-deps)"
      cmd=("$dir/.venv/bin/alembic" upgrade head)
      envf="$(env_file "$slug")"
      ;;
    composer)
      need_args $# 2
      # No scripts or plugins: dependency packages cannot run code at install time.
      cmd=(composer install --no-dev --no-scripts --no-plugins --optimize-autoloader --prefer-dist
           --no-progress --no-interaction "--working-dir=$dir")
      ;;
    php)
      need_args $# 3
      [[ $3 =~ ^[A-Za-z0-9_-]{1,64}\.php$ ]] || die "invalid script name"
      [[ -f $dir/$3 && ! -L $dir/$3 ]] || die "script $3 not found in the instance"
      cmd=(php "$3")
      ;;
    *) die "invalid task" ;;
  esac
  home="$(mktemp -d)"
  chown "$user:$user" "$home"
  local base=(PATH="$RUNTIME_DIR/bin:$PATH" LANG=C.UTF-8 HOME="$home" COMPOSER_HOME="$home" COMPOSER_NO_INTERACTION=1
    UV_PYTHON_INSTALL_DIR="$RUNTIME_DIR/python" UV_PYTHON_DOWNLOADS=never UV_PYTHON_PREFERENCE=only-managed
    UV_CACHE_DIR="$dir/.cache/uv" UV_LINK_MODE=copy BUN_INSTALL_CACHE_DIR="$dir/.cache/bun" DO_NOT_TRACK=1)
  rc=0
  # stdout goes to stderr too: PHP CLI prints fatal errors on stdout, and the panel shows stderr.
  if [[ -n $envf ]]; then
    # The bot's secrets go in through stdin and the environment, never the command line (ps).
    (cd -P -- "$dir" && timeout "$limit" runuser -u "$user" -- env -i "${base[@]}" \
      bash -c 'set -a; . /dev/stdin; set +a; exec "$@"' fleetpanel-run "${cmd[@]}" <"$envf") >&2 || rc=$?
  else
    (cd -P -- "$dir" && timeout "$limit" runuser -u "$user" -- env -i "${base[@]}" "${cmd[@]}" </dev/null) >&2 || rc=$?
  fi
  rm -rf -- "$home"
  [[ $rc -eq 0 ]] || die "$task failed with exit code $rc"
}

# instance-create SLUG DOMAIN WEBHOOK_PATH AUTH   (stdin: webhook secret)
# AUTH is how Telegram proves a webhook call, matching what the bot itself checks:
#   header  X-Telegram-Bot-Api-Secret-Token
#   query   ?secret=... in the webhook URL
cmd_instance_create() {
  need_args $# 4
  local slug="$1" domain="$2" hook="$3" auth="$4" secret user dir php pool vhost link guard
  check_slug "$slug"
  check_domain "$domain"
  check_hook "$hook"
  secret="$(read_stdin_value)"
  [[ $secret =~ $RE_SECRET ]] || die "invalid webhook secret"
  case "$auth" in
    header) guard="if (\$http_x_telegram_bot_api_secret_token != \"$secret\") { return 403; }" ;;
    # The secret is in the URL: keep it out of the access log.
    query) guard="if (\$arg_secret != \"$secret\") { return 403; }
        access_log off;" ;;
    *) die "invalid webhook auth mode" ;;
  esac

  user="$(instance_user "$slug")"
  dir="$(instance_dir "$slug")"
  php="$(php_version)"
  pool="$(pool_file "$slug" "$php")"
  vhost="$(vhost_file "$slug")"
  link="$(vhost_link "$slug")"
  require_instance_dir "$dir"
  ensure_instance_user "$user" "$dir"
  ensure_server_names_hash

  # Two sites with the same server_name only produce an nginx *warning*, and nginx then
  # silently routes the domain to whichever file sorts first. Refuse instead.
  local other
  other="$(domain_used_by "$domain" "$(vhost_link "$slug")")"
  [[ -z $other ]] || die "domain $domain is already served by $other; remove that site or use another domain"

  cat > "$pool" <<EOF
; Managed by FleetPanel. Instance: $slug
[fleetpanel-$slug]
user = $user
group = $user
listen = /run/php/fleetpanel-$slug.sock
listen.owner = $WEB_USER
listen.group = $WEB_USER
listen.mode = 0660
pm = ondemand
pm.max_children = 8
pm.process_idle_timeout = 60s
pm.max_requests = 500
chdir = $dir
php_admin_value[open_basedir] = $dir/:/tmp/
php_admin_value[error_log] = $dir/php-error.log
php_admin_flag[log_errors] = on
php_admin_flag[display_errors] = off
EOF

  cat > "$vhost" <<EOF
# Managed by FleetPanel. Instance: $slug
server {
    listen 80;
    listen [::]:80;
    server_name $domain;
    root $dir;
    index index.php;
    client_max_body_size 32m;
    access_log /var/log/nginx/fleetpanel-$slug.access.log;
    error_log /var/log/nginx/fleetpanel-$slug.error.log;
    # A symlink planted by a compromised bot must not expose other bots' files.
    disable_symlinks if_not_owner from=\$document_root;

    # Never serve dotfiles, dumps, logs, data files, archives, exports, configs or dependencies.
    # The bots write database backups (.zip) and exports (.xlsx/.csv) inside their own folder.
    location ~ /\.(?!well-known/) { deny all; }
    location ~* \.(sql|log|ini|env|bak|sh|lock|md|json|txt|zip|tar|gz|tgz|bz2|xz|7z|rar|db|sqlite|csv|xls|xlsx|pem|key)\$ { deny all; }
    location ~ (^|/)error_log\$ { deny all; }
    location ~ ^/(config\.php|config/|vendor/|db/|logs/) { deny all; }

    # Telegram webhook: only requests carrying our secret reach PHP
    location = /$hook {
        $guard
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/fleetpanel-$slug.sock;
    }

    location ~ \.php\$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/fleetpanel-$slug.sock;
    }

    location / { try_files \$uri \$uri/ =404; }
}
EOF

  ln -sfn "$vhost" "$link"
  if ! config_ok "$php"; then
    rm -f "$pool" "$vhost" "$link"
    die "generated configuration failed validation; nothing was enabled. ${CONFIG_ERROR}"
  fi
  reload_services "$php"
}

# download URL FILE SHA256: HTTPS only, and the file must match the pinned checksum.
download() {
  curl -fsSL --proto '=https' --tlsv1.2 --retry 3 -o "$2" "$1" || die "download failed: $1"
  printf '%s  %s\n' "$3" "$2" | sha256sum -c --quiet - >/dev/null 2>&1 || die "checksum mismatch for $1"
}

write_pyrun() {
  install -d -m 0755 "$(dirname "$PYRUN")"
  cat > "$PYRUN.tmp" <<'EOF'
"""FleetPanel launcher: runs a Python bot with its web server bound to loopback only.

Some bots hard-code uvicorn's host to 0.0.0.0, which would publish their API on every
interface without TLS. nginx is the only way in, so the host is forced to 127.0.0.1.
"""
import runpy
import sys

import uvicorn

_init = uvicorn.Config.__init__


def _loopback_only(self, *args, **kwargs):
    kwargs["host"] = "127.0.0.1"
    _init(self, *args, **kwargs)


uvicorn.Config.__init__ = _loopback_only

script = sys.argv[1]
sys.argv = sys.argv[1:]
sys.path.insert(0, script.rsplit("/", 1)[0])
runpy.run_path(script, run_name="__main__")
EOF
  chmod 0644 "$PYRUN.tmp"
  mv -f "$PYRUN.tmp" "$PYRUN"
}

# runtime-python
# Installs what service bots need, once per server: Redis and build tools (apt), and pinned,
# checksum-verified uv, bun and Python. Re-running it is cheap and repairs a broken install.
cmd_runtime_python() {
  need_args $# 0
  local arch bun_arch uv_sha bun_sha pkg tmp missing=() fresh_redis=0
  case "$(uname -m)" in
    x86_64)
      arch=x86_64 bun_arch=x64
      uv_sha=8cc1cd82d434ec565376f98bd938d4b715b5791a80ff2d3aa78821cf85091b4b
      bun_sha=36368faef7527875d5ffa52e53cd48021741f2a83eb6208a8dd64068d422a913
      ;;
    aarch64)
      arch=aarch64 bun_arch=aarch64
      uv_sha=d74f23949fd07be4970f293d06ca99d87cd2a78a341c3d7b7fc0df7bc2d8a145
      bun_sha=54328bbc2d9c8e0c9f892c544d66c57a83b84139e34909e5ee81758f1ac8fda7
      ;;
    *) die "unsupported CPU architecture: $(uname -m)" ;;
  esac

  for pkg in redis-server build-essential pkg-config libffi-dev libssl-dev unzip; do
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' || missing+=("$pkg")
  done
  if (( ${#missing[@]} )); then
    [[ " ${missing[*]} " == *" redis-server "* ]] && fresh_redis=1
    export DEBIAN_FRONTEND=noninteractive
    apt-get install -y -qq --no-install-recommends "${missing[@]}" >&2 \
      || { apt-get update -qq >&2 && apt-get install -y -qq --no-install-recommends "${missing[@]}" >&2; } \
      || die "could not install: ${missing[*]}"
    # Every bot runs its own Redis; the distribution's shared one is not needed (if we added it).
    if (( fresh_redis )); then systemctl disable --now redis-server >/dev/null 2>&1 || true; fi
  fi
  [[ -x $REDIS_SERVER ]] || die "$REDIS_SERVER is missing"

  install -d -m 0755 "$RUNTIME_DIR" "$RUNTIME_DIR/bin" "$RUNTIME_DIR/python"
  tmp="$(mktemp -d)"
  if [[ "$("$RUNTIME_DIR/bin/uv" --version 2>/dev/null)" != "uv $UV_VERSION"* ]]; then
    download "https://github.com/astral-sh/uv/releases/download/$UV_VERSION/uv-$arch-unknown-linux-gnu.tar.gz" "$tmp/uv.tar.gz" "$uv_sha"
    tar -xzf "$tmp/uv.tar.gz" -C "$tmp"
    install -m 0755 "$tmp/uv-$arch-unknown-linux-gnu/uv" "$RUNTIME_DIR/bin/uv"
  fi
  if [[ "$("$RUNTIME_DIR/bin/bun" --version 2>/dev/null)" != "$BUN_VERSION" ]]; then
    download "https://github.com/oven-sh/bun/releases/download/bun-v$BUN_VERSION/bun-linux-$bun_arch.zip" "$tmp/bun.zip" "$bun_sha"
    unzip -q -o "$tmp/bun.zip" -d "$tmp"
    install -m 0755 "$tmp/bun-linux-$bun_arch/bun" "$RUNTIME_DIR/bin/bun"
  fi
  rm -rf -- "$tmp"
  # uv checks the interpreter download against the checksums built into this pinned uv release.
  UV_PYTHON_INSTALL_DIR="$RUNTIME_DIR/python" UV_PYTHON_BIN_DIR="$RUNTIME_DIR/python/bin" UV_NO_CACHE=1 \
    "$RUNTIME_DIR/bin/uv" python install "$PYTHON_SERIES" >&2 || die "could not install Python $PYTHON_SERIES"
  chmod -R a+rX "$RUNTIME_DIR"
  write_pyrun
}

# instance-env SLUG   (stdin: KEY=value lines)
# Stores a service bot's environment (bot token, database URL, ...) readable by root only;
# systemd and instance-run hand it to the bot's process, never on a command line.
cmd_instance_env() {
  need_args $# 1
  local slug="$1" line key tmp n=0
  check_slug "$slug"
  install -d -m 0700 "$ENV_DIR"
  tmp="$(mktemp "$ENV_DIR/.env.XXXXXX")"
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line ]] && continue
    [[ $line =~ $RE_ENV_LINE ]] || { rm -f "$tmp"; die "invalid environment line"; }
    key="${line%%=*}"
    [[ $ENV_KEYS == *" $key "* ]] || { rm -f "$tmp"; die "environment variable $key is not allowed"; }
    printf '%s\n' "$line" >> "$tmp"
    n=$((n + 1))
  done
  (( n > 0 )) || { rm -f "$tmp"; die "empty environment"; }
  chmod 0600 "$tmp"
  mv -f "$tmp" "$(env_file "$slug")"
}

# service-create SLUG DOMAIN PORT
# systemd services for the bot and its Redis (sandboxed, as the bot's user) and an nginx
# reverse proxy to 127.0.0.1:PORT. Starts (or restarts) the bot.
cmd_service_create() {
  need_args $# 3
  local slug="$1" domain="$2" port="$3" user dir envf vhost link other sub
  check_slug "$slug"
  check_domain "$domain"
  [[ $port =~ $RE_PORT ]] || die "invalid port"
  user="$(instance_user "$slug")"
  dir="$(instance_dir "$slug")"
  envf="$(env_file "$slug")"
  vhost="$(vhost_file "$slug")"
  link="$(vhost_link "$slug")"
  require_instance_dir "$dir"
  require_runtime
  [[ -f $envf ]] || die "the bot's environment is missing (instance-env)"
  [[ -x $dir/.venv/bin/python && -f $dir/main.py ]] || die "the bot is not installed (python-deps)"
  # The control plane created these (instance-perms handed them over); never create or chown
  # paths inside the instance as root here, a symlink planted there could redirect it.
  for sub in workdir logs sessions data/redis; do
    [[ -d $dir/$sub && ! -L $dir/$sub ]] || die "missing instance directory $sub"
  done
  id -u "$user" >/dev/null 2>&1 || die "instance user does not exist (run instance-perms first)"
  if ss -Hltn "sport = :$port" 2>/dev/null | grep -q . && ! systemctl is-active --quiet "$(bot_unit "$slug")"; then
    die "port $port is already in use by another program"
  fi
  ensure_server_names_hash
  other="$(domain_used_by "$domain" "$link")"
  [[ -z $other ]] || die "domain $domain is already served by $other; remove that site or use another domain"

  cat > "$(unit_path "$(redis_unit "$slug")")" <<EOF
# Managed by FleetPanel. Instance: $slug
[Unit]
Description=FleetPanel Redis for $slug
PartOf=$(bot_unit "$slug")

[Service]
User=$user
Group=$user
ExecStart=$REDIS_SERVER --port 0 --unixsocket $dir/data/redis/redis.sock --unixsocketperm 700 --dir $dir/data/redis --save 60 1 --appendonly no --daemonize no
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=$dir/data/redis
MemoryMax=256M

[Install]
WantedBy=multi-user.target
EOF

  cat > "$(unit_path "$(bot_unit "$slug")")" <<EOF
# Managed by FleetPanel. Instance: $slug
[Unit]
Description=FleetPanel bot $slug
Wants=network-online.target
After=network-online.target mariadb.service mysql.service $(redis_unit "$slug")
Requires=$(redis_unit "$slug")

[Service]
User=$user
Group=$user
WorkingDirectory=$dir/workdir
EnvironmentFile=$envf
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=$dir/.venv/bin/python $PYRUN $dir/main.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=$dir
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1G

[Install]
WantedBy=multi-user.target
EOF
  chmod 0644 "$(unit_path "$(redis_unit "$slug")")" "$(unit_path "$(bot_unit "$slug")")"

  cat > "$vhost" <<EOF
# Managed by FleetPanel. Instance: $slug
server {
    listen 80;
    listen [::]:80;
    server_name $domain;
    client_max_body_size 32m;
    access_log /var/log/nginx/fleetpanel-$slug.access.log;
    error_log /var/log/nginx/fleetpanel-$slug.error.log;

    # The bot's interactive API documentation maps every endpoint; keep it private.
    location ~ ^/(docs|redoc|openapi\.json)(/|\$) { return 404; }

    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_read_timeout 120s;
    }
}
EOF
  ln -sfn "$vhost" "$link"
  if ! nginx_ok; then
    rm -f "$vhost" "$link"
    die "generated nginx configuration failed validation; nothing was enabled. ${CONFIG_ERROR}"
  fi
  systemctl daemon-reload
  systemctl enable --now "$(redis_unit "$slug")" >/dev/null 2>&1 || die "Redis for $slug did not start: $(journalctl -u "$(redis_unit "$slug")" -n 5 --no-pager -o cat 2>/dev/null | tr '\n' ' ')"
  systemctl enable "$(bot_unit "$slug")" >/dev/null 2>&1
  systemctl restart "$(bot_unit "$slug")"
  systemctl reload nginx
}

# service-wait SLUG PORT
# Waits until the bot's web server answers on loopback and listens nowhere else.
cmd_service_wait() {
  need_args $# 2
  local slug="$1" port="$2" unit i listeners
  check_slug "$slug"
  [[ $port =~ $RE_PORT ]] || die "invalid port"
  unit="$(bot_unit "$slug")"
  for i in $(seq 1 45); do
    if curl -fsS -o /dev/null --max-time 3 "http://127.0.0.1:$port/"; then
      listeners="$(ss -Hltn "sport = :$port" 2>/dev/null | awk '{print $4}' | grep -v '^127\.0\.0\.1:' || true)"
      if [[ -n $listeners ]]; then
        systemctl stop "$unit" || true
        die "the bot also listens on a public address ($listeners); it was stopped"
      fi
      return 0
    fi
    # Restart=always keeps a crashing bot in activating/auto-restart; give up after a few rounds.
    if (( i > 10 )) && [[ "$(systemctl show -p NRestarts --value "$unit" 2>/dev/null || echo 0)" -ge 3 ]]; then break; fi
    sleep 2
  done
  journalctl -u "$unit" -n 25 --no-pager -o cat >&2 2>/dev/null || true
  die "the bot did not start; its last log lines are above (journalctl -u $unit)"
}

service_enable() {
  local slug="$1" vhost link
  vhost="$(vhost_file "$slug")"
  link="$(vhost_link "$slug")"
  [[ -f $vhost && -f "$(unit_path "$(bot_unit "$slug")")" ]] || die "instance is not provisioned"
  systemctl enable --now "$(redis_unit "$slug")" "$(bot_unit "$slug")" >/dev/null 2>&1 || die "the bot's services did not start (journalctl -u $(bot_unit "$slug"))"
  ln -sfn "$vhost" "$link"
  if ! nginx_ok; then
    rm -f "$link"
    die "configuration test failed; site left disabled. ${CONFIG_ERROR}"
  fi
  systemctl reload nginx
}

service_disable() {
  local slug="$1"
  rm -f "$(vhost_link "$slug")"
  systemctl disable --now "$(bot_unit "$slug")" "$(redis_unit "$slug")" >/dev/null 2>&1 || true
  nginx_ok || die "configuration test failed after disabling. ${CONFIG_ERROR}"
  systemctl reload nginx
}

service_remove() {
  local slug="$1" unit
  for unit in "$(bot_unit "$slug")" "$(redis_unit "$slug")"; do
    systemctl disable --now "$unit" >/dev/null 2>&1 || true
    rm -f "$(unit_path "$unit")"
  done
  systemctl daemon-reload
  rm -f "$(env_file "$slug")"
}

# instance-enable SLUG
cmd_instance_enable() {
  need_args $# 1
  local slug="$1" php pool vhost link
  check_slug "$slug"
  if is_service_instance "$slug"; then service_enable "$slug"; return; fi
  php="$(php_version)"
  pool="$(pool_file "$slug" "$php")"
  vhost="$(vhost_file "$slug")"
  link="$(vhost_link "$slug")"
  [[ -f $vhost ]] || die "instance is not provisioned"
  if [[ -f "$pool.disabled" ]]; then mv -f "$pool.disabled" "$pool"; fi
  [[ -f $pool ]] || die "php-fpm pool is missing"
  ln -sfn "$vhost" "$link"
  if ! config_ok "$php"; then
    rm -f "$link"
    die "configuration test failed; instance left disabled. ${CONFIG_ERROR}"
  fi
  reload_services "$php"
}

# instance-disable SLUG
cmd_instance_disable() {
  need_args $# 1
  local slug="$1" php pool
  check_slug "$slug"
  if is_service_instance "$slug"; then service_disable "$slug"; return; fi
  php="$(php_version)"
  pool="$(pool_file "$slug" "$php")"
  rm -f "$(vhost_link "$slug")"
  if [[ -f $pool ]]; then mv -f "$pool" "$pool.disabled"; fi
  config_ok "$php" || die "configuration test failed after disabling. ${CONFIG_ERROR}"
  reload_services "$php"
}

# instance-remove SLUG  (idempotent)
cmd_instance_remove() {
  need_args $# 1
  local slug="$1" php pool user dir real
  check_slug "$slug"
  php="$(php_version)"
  pool="$(pool_file "$slug" "$php")"
  user="$(instance_user "$slug")"
  dir="$(instance_dir "$slug")"

  # A service bot first: stop it before its files and user disappear.
  service_remove "$slug"
  rm -f "$(vhost_link "$slug")" "$(vhost_file "$slug")" "$pool" "$pool.disabled"
  if config_ok "$php"; then reload_services "$php"; fi

  if [[ -L $dir ]]; then die "refusing to remove symlinked instance directory"; fi
  if [[ -e $dir ]]; then
    real="$(realpath -e -- "$dir")"
    [[ $real == "$INSTANCES_DIR/$slug" ]] || die "refusing to remove unexpected path"
    rm -rf --one-file-system -- "$dir"
  fi

  if id -u "$user" >/dev/null 2>&1; then
    pkill -u "$user" >/dev/null 2>&1 || true
    userdel "$user" >/dev/null 2>&1 || true
  fi
  if getent group "$user" >/dev/null 2>&1; then groupdel "$user" >/dev/null 2>&1 || true; fi
}

# db-create DB_NAME DB_USER   (stdin: password)  (idempotent, rotates password)
cmd_db_create() {
  need_args $# 2
  local db="$1" user="$2" password
  check_db_ident "$db"
  check_db_ident "$user"
  password="$(read_stdin_value)"
  [[ $password =~ $RE_DB_PASSWORD ]] || die "invalid database password"
  mysql --protocol=socket -u root <<SQL
CREATE DATABASE IF NOT EXISTS \`$db\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '$user'@'localhost' IDENTIFIED BY '$password';
ALTER USER '$user'@'localhost' IDENTIFIED BY '$password';
GRANT ALL PRIVILEGES ON \`$db\`.* TO '$user'@'localhost';
FLUSH PRIVILEGES;
SQL
}

# db-drop DB_NAME DB_USER  (idempotent)
cmd_db_drop() {
  need_args $# 2
  local db="$1" user="$2"
  check_db_ident "$db"
  check_db_ident "$user"
  mysql --protocol=socket -u root <<SQL
DROP DATABASE IF EXISTS \`$db\`;
DROP USER IF EXISTS '$user'@'localhost';
FLUSH PRIVILEGES;
SQL
}

# cert-issue DOMAIN
cmd_cert_issue() {
  need_args $# 1
  local domain="$1" email out
  check_domain "$domain"
  local args=(--nginx -d "$domain" --non-interactive --agree-tos --redirect --keep-until-expiring)
  email="$(cat /etc/fleetpanel/acme-email 2>/dev/null || true)"
  if [[ $email =~ $RE_EMAIL ]]; then
    args+=(--email "$email")
  else
    args+=(--register-unsafely-without-email)
  fi
  if ! out="$(certbot "${args[@]}" 2>&1)"; then
    printf '%s\n' "$out" | tail -n 5 >&2
    die "certificate issuance failed for $domain (does DNS point to this server and is port 80 reachable?)"
  fi
}

main() {
  [[ $EUID -eq 0 ]] || die "must run as root"
  local cmd="${1:-}"
  if [[ $# -gt 0 ]]; then shift; fi
  case "$cmd" in
    instance-create)  cmd_instance_create "$@" ;;
    instance-perms)   cmd_instance_perms "$@" ;;
    instance-run)     cmd_instance_run "$@" ;;
    instance-enable)  cmd_instance_enable "$@" ;;
    instance-disable) cmd_instance_disable "$@" ;;
    instance-remove)  cmd_instance_remove "$@" ;;
    db-create)        cmd_db_create "$@" ;;
    db-drop)          cmd_db_drop "$@" ;;
    cert-issue)       cmd_cert_issue "$@" ;;
    runtime-python)   cmd_runtime_python "$@" ;;
    instance-env)     cmd_instance_env "$@" ;;
    service-create)   cmd_service_create "$@" ;;
    service-wait)     cmd_service_wait "$@" ;;
    *) die "unknown command '${cmd}'" ;;
  esac
}

main "$@"
